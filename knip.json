{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/cli/main.ts",
    "src/cli/bin.ts",
    "scripts/*.mjs",
    "test/unit/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/*.mjs"
  ],
  "ignore": [
    "test/golden/**",
    "src/**/*.gen.ts",
    "test/fixtures/**"
  ],
  "ignoreBinaries": [
    "openssl",
    "desktop-file-validate"
  ]
}
