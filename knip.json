{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/cli/main.ts",
    "src/crawl/crawler.ts",
    "src/crawl/report-scrub.ts",
    "src/crawl/report-read.ts",
    "src/audit/audit.ts",
    "src/project/crawl.ts",
    "scripts/*.mjs",
    "test/unit/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/*.mjs"
  ],
  "ignore": [
    "test/golden/**",
    "src/**/*.gen.ts",
    "test/fixtures/**"
  ],
  "stryker": false,
  "ignoreBinaries": [
    "openssl"
  ]
}
