          "status": 301,
          "to": "http://fixture.test/pokedex/all"
        }
      }
    ],
    "why": "Every click on one of these links costs an extra round trip before the page starts loading, and search engines see one page at two addresses.",
    "fix": "Link to each page's final address (with or without its trailing slash, as the server serves it)."
  },
  {
    "code": "SITE-28",
    "severity": "minor",
    "listed": [
      "address",
      "addresses"
    ],
    "title": "The site has no sitemap search engines can read",
    "where": [
      {
        "url": "http://fixture.test/sitemap.xml",
        "says": "answered 404",
        "item": {
          "at": "file",
          "key": "missing",
          "url": "http://fixture.test/sitemap.xml",
          "status": 404
        }
      }
    ],
    "why": "A sitemap tells search engines every page to index, and how fresh each is; without one they find pages only by following links, and one listing wrong addresses spends their visits on errors.",
    "fix": "Publish /sitemap.xml listing each page's final address (most site builders and CMSs have a setting or plugin for it), and name it in robots.txt (Sitemap: ...)."
  },
