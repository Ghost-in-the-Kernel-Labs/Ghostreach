#!/bin/sh
# Ghostreach from this folder, for a copy of its source (GR-018): `./ghostreach`, `./ghostreach --help`, `./ghostreach <site>`.
# scripts/launch.mjs installs the packages from the lockfile and builds the program when this copy is new or was updated (a
# `git pull`), saying so in one line, and does nothing when nothing changed (J-070); then the program runs. The installed package
# has its own command, so this file is not packed. `npm link` once in this folder makes the bare word `ghostreach` work in any folder.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v node >/dev/null 2>&1 || { echo "Ghostreach needs Node.js 24 (or 22.18 or later). Copy this message to Ghost."; exit 1; }
node "$here/scripts/launch.mjs" || exit 1
exec node "$here/dist/cli/bin.js" "$@"
