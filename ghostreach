#!/bin/sh
# Ghostreach from this folder, for a copy of its source (GR-018): `./ghostreach`, `./ghostreach --help`, `./ghostreach <site>`.
# The first time, it installs the program's packages from the lockfile and builds it, saying so. The installed package has its own
# command, so this file is not packed. `npm link` once in this folder makes the bare word `ghostreach` work in any folder.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -f "$here/dist/cli/bin.js" ]; then
  echo "Ghostreach is not built in this folder yet. Building it once now (this takes a minute)..."
  if [ ! -d "$here/node_modules" ]; then
    (cd "$here" && npm ci --no-audit --no-fund) || { echo "Could not install Ghostreach's packages. It needs Node.js 24 (or 22.18 or later) and npm 11. Copy the message above to Ghost."; exit 1; }
  fi
  (cd "$here" && npm run build --silent) || { echo "Could not build Ghostreach. Copy the message above to Ghost."; exit 1; }
fi
exec node "$here/dist/cli/bin.js" "$@"
